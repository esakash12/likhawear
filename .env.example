APP_NAME="Zinnia Bangladesh"
APP_ENV=production
APP_KEY=base64:M5mboTDrIAXXP6aRTwWFQ1VAqjA0//XfcP1iAjNqyoI=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# -------------------------------------------------------------
# cPanel MySQL Database Configuration (cPanel ডেটাবেজ সেটিংস)
# -------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yourcpaneluser_zinnia
DB_USERNAME=yourcpaneluser_zinnia_user
DB_PASSWORD=YourStrongPasswordHere

# -------------------------------------------------------------
# Session & Cache (File driver is fastest on low-cost cPanel)
# -------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# -------------------------------------------------------------
# File Storage
# -------------------------------------------------------------
FILESYSTEM_DISK=public

# -------------------------------------------------------------
# Mail Settings (Optional - cPanel webmail / Gmail SMTP)
# -------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
